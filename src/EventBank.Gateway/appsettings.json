{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": ["http://localhost:5173"]
  },
  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "accounts",
        "Match": { "Path": "/api/accounts/{**rest}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "accounts-root": {
        "ClusterId": "accounts",
        "Match": { "Path": "/api/accounts" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "accounts-ops": {
        "ClusterId": "accounts",
        "Match": { "Path": "/api/ops/accounts/{**rest}" },
        "Transforms": [{ "PathPattern": "/ops/{**rest}" }]
      },
      "transfers": {
        "ClusterId": "transfers",
        "Match": { "Path": "/api/transfers/{**rest}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "transfers-root": {
        "ClusterId": "transfers",
        "Match": { "Path": "/api/transfers" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "transfers-ops": {
        "ClusterId": "transfers",
        "Match": { "Path": "/api/ops/transfers/{**rest}" },
        "Transforms": [{ "PathPattern": "/ops/{**rest}" }]
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "transfers": {
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      }
    }
  }
}
