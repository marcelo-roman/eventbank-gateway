{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/accounts/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "accounts-root": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/accounts"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "transfers": {
        "ClusterId": "transfers",
        "Match": {
          "Path": "/api/transfers/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "transfers-root": {
        "ClusterId": "transfers",
        "Match": {
          "Path": "/api/transfers"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "pix": {
        "ClusterId": "transfers",
        "Match": {
          "Path": "/api/pix/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "pix-root": {
        "ClusterId": "transfers",
        "Match": {
          "Path": "/api/pix"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "customers": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/api/customers/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "customers-root": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/api/customers"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "cards": {
        "ClusterId": "cards",
        "Match": {
          "Path": "/api/cards/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "cards-root": {
        "ClusterId": "cards",
        "Match": {
          "Path": "/api/cards"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/notifications/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "notifications-root": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/notifications"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "accounts-ops": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/ops/accounts/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/ops/{**rest}"
          }
        ]
      },
      "transfers-ops": {
        "ClusterId": "transfers",
        "Match": {
          "Path": "/api/ops/transfers/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/ops/{**rest}"
          }
        ]
      },
      "customers-ops": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/api/ops/customers/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/ops/{**rest}"
          }
        ]
      },
      "cards-ops": {
        "ClusterId": "cards",
        "Match": {
          "Path": "/api/ops/cards/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/ops/{**rest}"
          }
        ]
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "transfers": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "customers": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "cards": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105"
          }
        }
      }
    }
  }
